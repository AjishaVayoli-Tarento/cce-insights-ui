VITE_API_BASE_URL=
VITE_AUTH_ENABLED=false
VITE_POLLING_INTERVAL=60000
VITE_DEFAULT_DATE_RANGE_DAYS=30

# Keycloak OIDC — used when VITE_AUTH_ENABLED=true
# Must match the realm the gateway-service validates against (smartcare on keycloak.mdtlabs.org).
# Override at runtime via Docker env vars (docker/entrypoint.sh generates /srv/env-config.js).
VITE_KEYCLOAK_URL=https://keycloak.cce.mdtlabs.org/auth
VITE_KEYCLOAK_REALM=cce
VITE_KEYCLOAK_CLIENT_ID=cce-insights-ui
