:3001 {
	# Encode responses with gzip/zstd
	encode zstd gzip

	# Proxy API calls directly to insights-service (no gateway)
	handle /v1/insights/* {
		reverse_proxy cce-insights-service:8084
	}

	# Serve the built React SPA with SPA fallback
	handle {
		root * /srv

		# Cache static assets aggressively (hashed filenames)
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		try_files {path} /index.html
		file_server
	}

	# Security headers
	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
